# Auth type: on-prem | cloud-oauth | cloud-pat
UIPATH_AUTH_TYPE=cloud-oauth

# Required for ALL auth types
UIPATH_URL=https://cloud.uipath.com/your-org/your-tenant/
UIPATH_TENANT_NAME=Default

# --- cloud-oauth (default) ---
UIPATH_CLIENT_ID=your_client_id_here
UIPATH_CLIENT_SECRET=your_client_secret_here

# --- on-prem ---
# UIPATH_AUTH_TYPE=on-prem
# UIPATH_URL=https://your-orchestrator-server/
# UIPATH_USERNAME=admin
# UIPATH_PASSWORD=your_password

# --- cloud-pat ---
# UIPATH_AUTH_TYPE=cloud-pat
# UIPATH_PAT=rt_your_personal_access_token_here

# Optional
UIPATH_FOLDER_ID=
UIPATH_DISABLE_SSL_VERIFY=0
