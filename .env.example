# ── Required for ALL strategies ──────────────────────────────
UIPATH_URL=https://cloud.uipath.com/your-org/your-tenant/
UIPATH_TENANT_NAME=Default

# ── Pick ONE auth strategy ───────────────────────────────────
UIPATH_AUTH_TYPE=cloud-oauth        # SaaS Orchestrator (External Application)
# UIPATH_AUTH_TYPE=on-prem          # On-prem / sovereign (username + password)
# UIPATH_AUTH_TYPE=cloud-pat        # Personal scripts / quick prototyping

# cloud-oauth needs:
UIPATH_CLIENT_ID=your_client_id_here
UIPATH_CLIENT_SECRET=your_client_secret_here

# on-prem needs:
# UIPATH_URL=https://your-orchestrator-server/
# UIPATH_USERNAME=admin
# UIPATH_PASSWORD=your_password

# cloud-pat needs:
# UIPATH_PAT=rt_your_personal_access_token_here

# ── Optional (all strategies) ────────────────────────────────
UIPATH_FOLDER_ID=                   # Default Organizational Unit for API calls
UIPATH_DISABLE_SSL_VERIFY=0         # Set 1 to skip TLS checks (dev / self-signed only)
